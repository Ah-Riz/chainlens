# Copy to .env and fill values. Never commit .env.

# Solana JSON-RPC (public, Helius, Alchemy, etc. — opaque URL)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TX_FETCH_LIMIT=40

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database — TiDB Cloud (SQLAlchemy + asyncmy). Copy from TiDB console → Connect → SQLAlchemy.
# Example: mysql+asyncmy://user:pass@gateway.tidbcloud.com:4000/test?ssl=true
DATABASE_URL=mysql+asyncmy://root@127.0.0.1:4000/chainlens

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MOCK_ANALYZE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
