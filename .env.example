# Copy to .env and fill values. Never commit .env.

# Solana JSON-RPC (public, Helius, Alchemy, etc. — opaque URL)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TX_FETCH_LIMIT=40

# LLM (Google Gemini — AI Studio keys usually start with AIza)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database — TiDB Cloud. Prefer mysql+asyncmy:// (async). mysql:// and mysql+pymysql://
# from the TiDB console are auto-rewritten to asyncmy at startup.
# Example: mysql+asyncmy://user:pass@gateway.tidbcloud.com:4000/test?ssl=true
DATABASE_URL=mysql+asyncmy://root@127.0.0.1:4000/chainlens

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MOCK_ANALYZE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
